# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# Which provider `load` uses when --provider isn't passed on the command line.
UPLOAD_PROVIDER=s3

# --- Scraper identity (required for `extract`) ---
# The exact User-Agent header every request is sent with. There is no default:
# `extract` refuses to make a network request until this is set. Make it
# identify you -- your own name for this copy, plus a contact URL or email --
# so your traffic is never attributed to anyone else, and so the site can
# reach you if they need to. Quoted because the value contains spaces.
USER_AGENT="your-scraper/1.0 (+https://github.com/you/your-repo)"

# --- AWS S3 ---
# Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset if you're already using
# `aws configure` or an IAM role -- boto3's default credential chain picks
# those up automatically without needing them here. Only set them in this
# file if you want this project's credentials kept independent of your
# global AWS CLI config.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# --- Azure Blob Storage (not implemented yet -- reserved for later) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER=
